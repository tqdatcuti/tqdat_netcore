@model TongQuangDat2410900022_exam.Models.TqdStudent

@{
    ViewData["Title"] = "Xóa sinh viên";
}

<div class="page-heading">
    <div><p class="eyebrow">HỒ SƠ SINH VIÊN <span>·</span> DELETE</p><h1>Xóa sinh viên</h1></div>
</div>
<section class="student-form">
    <p class="text-danger fw-semibold">Bạn có chắc chắn muốn xóa hồ sơ này không?</p>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TqdName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TqdName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TqdGender)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TqdGender)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TqdBirthDay)
        </dt>
        <dd class = "col-sm-10">
            @Model.TqdBirthDay.ToString("dd/MM/yyyy")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TqdEmail)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TqdEmail)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TqdPhone)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TqdPhone)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TqdActive)
        </dt>
        <dd class = "col-sm-10">
            @(Model.TqdActive ? "Đang học" : "Đã nghỉ")
        </dd>
</dl>
    <form asp-action="Delete" class="d-flex gap-2">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</section>
