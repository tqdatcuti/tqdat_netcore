@model IEnumerable<TongQuangDat2410900022_exam.Models.TqdStudent>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">QUẢN LÝ HỒ SƠ <span>·</span> STUDENTS</p>
        <h1>Danh sách sinh viên</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create"><span aria-hidden="true">+</span> Thêm sinh viên</a>
</div>
<div class="table-responsive student-table-wrap">
<table class="table student-table align-middle">
    <thead>
        <tr>
            <th>
                Họ và tên
            </th>
            <th>
                Giới tính
            </th>
            <th>
                Ngày sinh
            </th>
            <th>
                Email
            </th>
            <th>
                Điện thoại
            </th>
            <th>
                Trạng thái
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TqdName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TqdGender)
            </td>
            <td>
                @item.TqdBirthDay.ToString("dd/MM/yyyy")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TqdEmail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TqdPhone)
            </td>
            <td>
                <span class="status-pill @(item.TqdActive ? "is-active" : "is-inactive")">@(item.TqdActive ? "Đang học" : "Đã nghỉ")</span>
            </td>
            <td>
                <div class="table-actions">
                    <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                    <a class="delete-link" asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
