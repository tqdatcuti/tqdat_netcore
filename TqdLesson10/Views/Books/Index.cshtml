@model IEnumerable<TqdLesson10.Models.Book>
@{
    ViewData["Title"] = "Kho sách";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div><h1 class="h2 mb-1">Kho sách</h1><p class="text-muted mb-0">Danh sách dữ liệu từ EF Core</p></div>
    <a asp-action="Create" class="btn btn-primary">+ Thêm sách</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-6"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên sách hoặc tác giả" /></div>
    <div class="col-md-4"><select name="categoryId" asp-items="ViewBag.Categories" class="form-select"><option value="">Tất cả danh mục</option></select></div>
    <div class="col-md-2 d-grid"><button class="btn btn-outline-primary" type="submit">Tìm kiếm</button></div>
</form>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark"><tr><th>Tên sách</th><th>Tác giả</th><th>Danh mục</th><th>Nhà xuất bản</th><th class="text-end">Giá</th><th></th></tr></thead>
        <tbody>
        @foreach (var book in Model)
        {
            <tr><td class="fw-semibold">@book.Title</td><td>@book.Author</td><td>@book.Category?.CategoryName</td><td>@book.Publisher?.PublisherName</td><td class="text-end">@book.Price.ToString("N0") đ</td><td class="text-end text-nowrap"><a asp-action="Details" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-secondary">Xem</a> <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-primary">Sửa</a> <a asp-action="Delete" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-danger">Xóa</a></td></tr>
        }
        </tbody>
    </table>
</div>