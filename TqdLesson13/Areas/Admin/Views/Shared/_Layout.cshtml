<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Layout Admin</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-layout">
    <header class="site-header">
        <div class="site-header-content">
            <a class="site-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">TRANG QUẢN TRỊ</a>
            <nav class="site-nav" aria-label="Điều hướng quản trị">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang chủ</a>
                <a asp-area="Customer" asp-controller="Store" asp-action="Index">Trang khách hàng</a>
            </nav>
        </div>
    </header>
    <main class="site-content">
        @RenderBody()
    </main>
    <footer class="site-footer">Bố cục trang quản trị (Admin)</footer>
</body>
</html>