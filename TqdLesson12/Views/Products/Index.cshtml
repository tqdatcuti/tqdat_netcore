@model IEnumerable<TqdLesson12.Models.Product>
@{
    ViewData["Title"] = "Sản phẩm";
}

<section class="page-heading">
    <div><p class="eyebrow">CATALOG / 02</p><h1>Sản phẩm</h1><p>Thông tin, giá bán và hình ảnh sản phẩm.</p></div>
    <a class="btn btn-dark" asp-action="Create">Thêm sản phẩm</a>
</section>

<div class="table-responsive data-table">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Ảnh</th><th>Sản phẩm</th><th>Danh mục</th><th>Giá</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.Image))
                    {
                        <img src="@item.Image" alt="@item.Name" class="table-thumb" />
                    }
                    else
                    {
                        <span class="text-secondary">—</span>
                    }
                </td>
                <td><strong>@item.Name</strong><div class="small text-secondary">@item.Description</div></td>
                <td>@item.Category?.Name</td>
                <td>@item.Price.ToString("N0") đ</td>
                <td>@(item.Status == 1 ? "Hiển thị" : "Ẩn")</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-secondary py-5">Chưa có sản phẩm nào.</td></tr>
        }
        </tbody>
    </table>
</div>