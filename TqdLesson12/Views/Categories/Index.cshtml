@model IEnumerable<TqdLesson12.Models.Category>
@{
    ViewData["Title"] = "Danh mục";
}

<section class="page-heading">
    <div><p class="eyebrow">CATALOG / 01</p><h1>Danh mục</h1><p>Phân loại sản phẩm trong cửa hàng.</p></div>
    <a class="btn btn-dark" asp-action="Create">Thêm danh mục</a>
</section>

<div class="table-responsive data-table">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Tên danh mục</th><th>Trạng thái</th><th>Sản phẩm</th><th>Ngày tạo</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-semibold">@item.Name</td>
                <td>@(item.Status == 1 ? "Hiển thị" : "Ẩn")</td>
                <td>@item.Products.Count</td>
                <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-secondary py-5">Chưa có danh mục nào.</td></tr>
        }
        </tbody>
    </table>
</div>