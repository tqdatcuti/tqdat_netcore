@model TqdLesson12.Models.Category
@{
    ViewData["Title"] = "Sửa danh mục";
}
<section class="page-heading"><div><p class="eyebrow">CATALOG / 01</p><h1>Sửa danh mục</h1></div></section>
<form asp-action="Edit" asp-route-id="@Model.Id" class="form-panel">
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
    <div class="d-flex gap-2"><button class="btn btn-dark" type="submit">Lưu thay đổi</button><a class="btn btn-outline-secondary" asp-action="Index">Hủy</a></div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }