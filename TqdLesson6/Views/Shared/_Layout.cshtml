<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Điện Máy Xanh</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TqdLesson6.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="top-nav" aria-label="Điều hướng chính">
            <a class="brand" asp-controller="Home" asp-action="Index"><span>ĐIỆN MÁY</span> XANH</a>
            <div class="nav-links">
                <a class="active" asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a href="#latest-products-title">Giới thiệu</a>
                <a href="#hot-products">Liên hệ</a>
                <a href="#latest-products-title">Sản phẩm</a>
            </div>
        </nav>
    </header>
    <div class="page-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
