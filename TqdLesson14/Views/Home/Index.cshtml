@{
    ViewData["Title"] = "Entity Framework Core";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm">
    <div class="container-fluid py-3">
        <span class="badge text-bg-primary mb-3">SESSION 06</span>
        <h1 class="display-5 fw-bold">Quản lý kho sách với EF Core</h1>
        <p class="col-md-8 fs-5">Demo Code-First, DbContext, quan hệ dữ liệu và các thao tác CRUD bằng ASP.NET Core MVC.</p>
        <a asp-controller="Books" asp-action="Index" class="btn btn-primary btn-lg">Mở kho sách</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4"><div class="card h-100 shadow-sm"><div class="card-body"><h2 class="h5">DbContext</h2><p class="text-muted mb-0">Quản lý kết nối, model và quan hệ giữa các bảng.</p></div></div></div>
    <div class="col-md-4"><div class="card h-100 shadow-sm"><div class="card-body"><h2 class="h5">CRUD</h2><p class="text-muted mb-0">Thêm, xem, sửa và xóa sách trực tiếp trên giao diện.</p></div></div></div>
    <div class="col-md-4"><div class="card h-100 shadow-sm"><div class="card-body"><h2 class="h5">LINQ</h2><p class="text-muted mb-0">Tìm kiếm, lọc danh mục và sắp xếp dữ liệu.</p></div></div></div>
</div>
